# ==============================================================================
# BIẾN MÔI TRƯỜNG HỆ THỐNG AI PHÂN TÍCH KHÁCH HÀNG
# Sao chép file này thành .env và điền các giá trị mong muốn:
#   copy .env.example .env
# ==============================================================================

# Đường dẫn file dữ liệu mặc định (CSV)
DATA_PATH=D:\archive (6)\supermarket_large_datasets.csv

# Thư mục lưu kết quả & model artifacts
ARTIFACTS_DIR=artifacts

# Số cụm ép buộc (Để trống để tự động dò theo Silhouette)
FINAL_K=

# Cách tính Frequency: auto (tự phát hiện) | transaction | days
FREQUENCY_MODE=auto

# Số ngày quan sát dự báo Churn / Giá trị tương lai
CHURN_HORIZON_DAYS=90

# Khóa Google Gemini API (để trống nếu chạy chế độ offline không cần API key)
# Lấy miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Cấu hình API Backend
API_URL=http://localhost:8000
